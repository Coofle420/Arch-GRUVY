// fastfetch — gruvbox dark
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "38;2;254;128;25", "2": "38;2;250;189;47" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " ✦ ",
    "color": {
      "title": "38;2;254;128;25",
      "separator": "38;2;124;111;100",
      "output": "38;2;235;219;178"
    },
    "percent": { "type": 1 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    "break",

    { "type": "custom", "format": "{#38;2;254;128;25}━━━━━  system  ━━━━━{#}" },
    { "type": "os",     "key": "distro ", "keyColor": "38;2;254;128;25" },
    { "type": "kernel", "key": "kernel ", "keyColor": "38;2;254;128;25" },
    { "type": "uptime", "key": "uptime ", "keyColor": "38;2;254;128;25" },
    { "type": "command", "key": "age    ", "keyColor": "38;2;254;128;25",
      "text": "d=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); [ \"$d\" = 1 ] && echo \"1 day\" || echo \"$d days\"" },
    "break",

    { "type": "custom", "format": "{#38;2;142;192;124}━━━━  desktop  ━━━━{#}" },
    { "type": "wm",       "key": "wm     ", "keyColor": "38;2;142;192;124" },
    { "type": "shell",    "key": "shell  ", "keyColor": "38;2;142;192;124" },
    { "type": "terminal", "key": "term   ", "keyColor": "38;2;142;192;124" },
    "break",

    { "type": "custom", "format": "{#38;2;250;189;47}━━━  hardware  ━━━{#}" },
    { "type": "cpu",    "key": "cpu    ", "keyColor": "38;2;250;189;47", "format": "{1} ({3})" },
    { "type": "gpu",    "key": "gpu    ", "keyColor": "38;2;250;189;47", "format": "{2}" },
    { "type": "memory", "key": "ram    ", "keyColor": "38;2;250;189;47" },
    { "type": "swap",   "key": "swap   ", "keyColor": "38;2;250;189;47" },
    { "type": "disk",   "key": "disk   ", "keyColor": "38;2;250;189;47", "folders": "/" },
    "break",

    { "type": "colors", "paddingLeft": 1, "symbol": "circle" },
    "break"
  ]
}
